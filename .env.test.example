# .env.test.example — local integration-test environment.
#
# Tests never read DATABASE_URL / DATABASE_ADMIN_URL / REDIS_URL. Copy this
# file to .env.test, start Laragon Postgres + Redis, then run `make test`.
# The runner creates a fresh agents_proxy_test_<timestamp> database and drops
# it on exit; TEST_DATABASE_* below are used as connection templates, not as
# a shared database. The database name in the URL is ignored by the runner.
#
# The runtime role is app_runtime (NOBYPASSRLS) so RLS is actually exercised.
# Migration/admin setup uses the postgres superuser.
TEST_DATABASE_URL=postgres://app_runtime@127.0.0.1:5432/agents_proxy_test?sslmode=disable
TEST_DATABASE_ADMIN_URL=postgres://postgres@127.0.0.1:5432/agents_proxy_test?sslmode=disable
# DB 15 is reserved for tests. Using the default DB 0 would let FlushDB wipe
# a developer's local cache; the URL must include the scheme for redisx.
TEST_REDIS_URL=redis://localhost:6379/15
