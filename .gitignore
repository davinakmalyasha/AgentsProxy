# Secrets — never commit
.env
.env.local
.env.*.local

# Binaries
bin/
*.exe
/tmp/

# Logs
*.log
*.pid
.air.toml

# Redis snapshots / dumps — never commit
*.rdb
dump.rdb

# Chat-generated report files (per-tenant .xlsx, token-authed, short-lived)
data/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Go
vendor/

# Local tool/session junk — worktree only, never commit
