run_proxy_temp.ps1
run_proxy_mock.ps1
run_proxy_mock2.ps1
shots/
appendonlydir/
.playwright-mcp/
.commandcode/

# Playwright/test output that lands in repo root — never commit
page-*.yml
console-*.log
laporan-*.xlsx
*.png

# Vercel build output at repo root (buildCommand -o server)
/server

# Supabase CLI local state
supabase/.temp/
