# .env.staging.example — copy to .env.staging (gitignored).
#
# Staging points at the second Supabase project, never production.
# The admin DSN is used by `go run ./cmd/migrate` and by nothing else.
# Both URLs may be the same admin DSN for the migration step; the app's
# Vercel staging variables use the app_runtime 6543 DSN instead.

ENV=staging
ALLOW_REMOTE_DB=true

# Staging direct/session 5432 postgres DSN (Project Settings -> Database).
DATABASE_URL=postgres://postgres.<staging-ref>:<staging-password>@<staging-pooler-host>:5432/postgres?sslmode=require
DATABASE_ADMIN_URL=postgres://postgres.<staging-ref>:<staging-password>@<staging-pooler-host>:5432/postgres?sslmode=require

RUN_MIGRATIONS=false
LLM_API_KEY=migrate-unused
ADMIN_API_KEY=migrate-unused
ALLOW_ORIGINS=https://staging.example.com
