# .env.staging.example — copy to .env.staging (gitignored).
#
# Staging points at the second Supabase project, never production.
# DATABASE_URL is the runtime role (app_runtime) on the 6543 transaction
# pooler; DATABASE_ADMIN_URL is the direct 5432 postgres DSN used only by
# migrations. Do not run the server on the postgres DSN: it bypasses RLS.

ENV=staging
ALLOW_REMOTE_DB=true
EXPECTED_DB_REF=<staging-ref>

# Runtime: app_runtime on Supavisor 6543 (transaction mode).
DATABASE_URL=postgres://app_runtime.<staging-ref>:<app-runtime-password>@<staging-pooler-host>:6543/postgres?sslmode=require&pgbouncer=true
# Migrations/admin: direct 5432 postgres.
DATABASE_ADMIN_URL=postgres://postgres.<staging-ref>:<staging-password>@<staging-pooler-host>:5432/postgres?sslmode=require

RUN_MIGRATIONS=false
LLM_API_KEY=migrate-unused
ADMIN_API_KEY=migrate-unused
ALLOW_ORIGINS=https://staging.example.com
