# .env.example — D:\MyProject\AgentsProxy — copy to .env, fill secrets, never commit .env
# Laragon dev: DATABASE_URL points at localhost:5432, REDIS_URL at localhost:6379.
# Prod (Railway/Hostinger): DATABASE_URL = Supabase pooler 6543 (TX mode), REDIS_URL = rediss://...

# --- Server ---
PORT=8080
ENV=development                    # development | staging | production (strict; anything else fails boot)

# --- Database (Supabase Postgres 17 — platform + one schema per project) ---
# Local development is LOCALHOST ONLY. A remote host fails boot unless
# ENV=staging and ALLOW_REMOTE_DB=true (staging is the only environment
# allowed to reach a non-local database from a non-production process).
# Laragon (local):  postgres://app_runtime@localhost:5432/agents_proxy?sslmode=disable
# Supabase (prod):  postgres://app_runtime.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true  (TX pooler)
DATABASE_URL=postgres://app_runtime@localhost:5432/agents_proxy?sslmode=disable
# Separate admin connection for DDL (migrations). Production: postgres superuser.
# Local Laragon dev: postgres superuser.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/agents_proxy?sslmode=disable
# Staging only: explicit opt-in for a remote database. Ignored in development
# (remote is always rejected) and production (remote is the normal case).
ALLOW_REMOTE_DB=false
# Admin pool sizing (DIRECT 5432 session mode is capped at pool_size 15 on small
# Supabase projects — a Min above 0 parks idle sessions per instance and cold
# starts exhaust the cap with EMAXCONNSESSION). Defaults: park nothing, max 3.
DB_ADMIN_POOL_MIN=0
DB_ADMIN_POOL_MAX=3
# Runtime pool sizing. Defaults: min 2, max 20.
DB_POOL_MIN=2
DB_POOL_MAX=20
# Supabase Supavisor 6543 (transaction mode) REQUIRES simple protocol:
# the pooler does not support prepared statements. DIRECT 5432 keeps
# extended protocol (default false).
DB_USE_SIMPLE_PROTOCOL=false

# --- Cache (Redis 8.10.1) ---
# Laragon: localhost:6379 (install via Laragon Quick Add → Redis, then Start). Prod: rediss://:pass@host:6379/0
REDIS_URL=localhost:6379

# --- LLM Provider (DeepSeek OpenAI-compatible, master key — NEVER in client sites) ---
LLM_BASE_URL=https://api.deepseek.com   # Provider-swappable (e.g. mimo endpoint year 2)
LLM_API_KEY=sk-REPLACE_ME              # REQUIRED — DeepSeek API key (env secret, never logged)
LLM_MODEL=deepseek-chat                 # Default model for chat proxy
LLM_COST_IN_PER_MTOK=0.14               # USD per 1M input tokens (estimate reported to tenants)
LLM_COST_OUT_PER_MTOK=0.28              # USD per 1M output tokens

# --- Daily LLM-call money caps per role (guard on the shared key) ---
CAP_CALLS_CLIENT=20
CAP_CALLS_PEGAWAI=80
CAP_CALLS_OWNER=150
RPD_CALLS_CLIENT=30
RPD_CALLS_PEGAWAI=80
RPD_CALLS_OWNER=150

# --- Auth (Admin — for POST /v1/admin/clients, token creation) ---
ADMIN_API_KEY=REPLACE_ME_WITH_openssl_rand_hex_32   # REQUIRED — generate: openssl rand -hex 32

# --- Business Logic ---
MAX_TOKENS_PER_REQUEST=2048           # Max tokens forwarded to provider per /v1/chat call
RATE_LIMIT_PER_MINUTE=60              # Per client_token_hash + per IP (unauth) sliding window (Redis INCR+EXPIRE)
AGENT_RATE_LIMIT_PER_MINUTE=20        # Stricter per-IP sub-limit for /v1/agent/* (landing polls)

# --- Background loops: does this process persist between requests? ---
# Controls BOTH the 60s reminder ticker and the notify drain loop,
# because both answer the same question: is this a long-lived process
# that can own background work?
#
# true  = long-running hosts (Laragon, VPS, Railway). The process stays
#         alive between ticks, so the loops actually run.
# false = serverless (Vercel), where the function is destroyed between
#         requests. The loops would never tick, and Supabase owns
#         delivery instead: a pg_cron job calls the deliver-reminders
#         Edge Function, and a Database Webhook on notify_jobs INSERT
#         handles notifications instantly.
#         Leaving it true on serverless is not a correctness bug (the two
#         drivers claim rows and cannot double-send) but it spends
#         Active CPU on loops that can never fire.
#
# Accepted values: true/1/yes/on and false/0/no/off/disabled (any case).
# Anything else fails boot loudly — a typo must never silently burn CPU.
#
# Only one should be active per environment. See ops/RUNBOOK-delivery.md.
BACKGROUND_TICKERS=true
# Migrations at boot. This is a local-development convenience:
#   development -> default true
#   staging/production -> default false (run `go run ./cmd/migrate` as a deploy step)
# Vercel preview/production may NEVER set this true; the process refuses to
# boot. Use the db-migrate workflow instead.
RUN_MIGRATIONS=true

# Trusted reverse-proxy CIDRs (comma-separated). When the app sits behind
# Render/Railway/nginx, list their egress CIDRs here so X-Forwarded-For /
# X-Real-IP are honored for rate-limit bucketing + client IP (see internal/api/clientip.go).
# Empty (default) = never trust forwarded headers.
# On Vercel leave this empty: the binary trusts X-Forwarded-For when
# VERCEL=1 because Vercel overwrites that header at its edge. Set this
# only when a self-managed proxy sits in front of a non-Vercel deploy.
TRUSTED_PROXY_CIDRS=

# --- CORS ---
ALLOW_ORIGINS=*                       # Dev: * . Prod: ONE fallback origin, e.g. https://dfdagency.vercel.app (never * or empty — both fail prod boot). The real multi-frontend list lives in the DB registry (frontend_origins + origin_suffix_rules, migration 058/069): one INSERT onboards a frontend, zero deploys, survives every update. Env is fallback only.

# --- Durable report storage (Supabase Storage) ---
# Prod: set both to use the private REPORT_BUCKET. The bucket must exist
# and stay private; downloads are app-proxied behind Redis tickets.
# Empty = local data/reports (dev/tests only, ephemeral on serverless).
SUPABASE_URL=                           # e.g. https://<ref>.supabase.co
SUPABASE_STORAGE_KEY=                   # server-only storage service key, never in clients
REPORT_BUCKET=reports
REPORT_MAX_BYTES=15000000

# --- Agency plane (DFD ops: /api/v1/*, /api/agent/*, /mcp) ---
# Empty JWT_SECRET disables the plane (503 on those routes) — proxy-only
# deploys boot unchanged. Set all three to go live.
JWT_SECRET=                              # REQUIRED for agency plane — min 32 chars
JWT_TTL_HOURS=720                       # 30-day session; refreshed while active (sliding <7d)
FRONTEND_URL=http://localhost:3000
AGENCY_WHATSAPP=

# --- Agency auth (golden standard: password + superadmin email OTP + Google) ---
GOOGLE_CLIENT_ID=                    # Google Cloud OAuth Web client ID (aud for /auth/google); empty disables it
RESEND_API_KEY=                        # Resend key for login/signup codes; empty = log-only (dev)
EMAIL_FROM=DFD Agency <hello@dfdagency.com>
# Self-service CLIENT registration (email + password + 6-digit code).
# Defaults to true in development, false in production. Turn it on in
# production only after EMAIL_FROM is on a Resend-verified domain; the
# sandbox sender (onboarding@resend.dev) can only mail the account owner.
SIGNUP_ENABLED=true

# --- Deferred report worker (migration 064) ---
# Enables POST /v1/internal/report-jobs/build; must match the Supabase
# Vault secret report_worker_token so pg_cron can call it. Empty = the
# endpoint answers 503 and enqueued jobs wait (nothing runs).
REPORT_WORKER_TOKEN=

# --- Sentry (env-gated; leave empty to disable entirely) ---
SENTRY_DSN=                           # REQUIRED to enable. Get from sentry.io project settings.
SENTRY_ENV=development                # development | staging | production
SENTRY_RELEASE=                       # default: build -ldflags (git rev)
TRACES_SAMPLE_RATE=0.1               # 0.0..1.0 (0 disables tracing)

# --- Tests ---
# The server never reads these; DB-backed tests read TEST_* only.
# Copy .env.test.example to .env.test (gitignored) and run `make test`.
# A test DSN must point at a local throwaway database.
# TEST_DATABASE_URL=postgres://app_runtime@127.0.0.1:5432/agents_proxy_test?sslmode=disable
# TEST_DATABASE_ADMIN_URL=postgres://postgres@127.0.0.1:5432/agents_proxy_test?sslmode=disable
# TEST_REDIS_URL=localhost:6379
