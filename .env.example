# .env.example — D:\MyProject\AgentsProxy — copy to .env, fill secrets, never commit .env
# Laragon dev: DATABASE_URL points at localhost:5432, REDIS_URL at localhost:6379.
# Prod (Railway/Hostinger): DATABASE_URL = Supabase pooler 6543 (TX mode), REDIS_URL = rediss://...

# --- Server ---
PORT=8080
ENV=development                    # development | production (tightens CORS, disables * origin)

# --- Database (Supabase Postgres 17 — ONE shared project, tenancy via tenant_id + RLS) ---
# Laragon (local):  postgres://postgres@localhost:5432/agents_proxy?sslmode=disable  (create DB in HeidiSQL first)
# Supabase (prod):  postgres://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true  (TX pooler)
DATABASE_URL=postgres://app@localhost:5432/agents_proxy?sslmode=disable
# Separate admin connection for DDL (migrations). Production: postgres superuser.
# Local Laragon dev: postgres superuser.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/agents_proxy?sslmode=disable
# Admin pool sizing (DIRECT 5432 session mode is capped at pool_size 15 on small
# Supabase projects — a Min above 0 parks idle sessions per instance and cold
# starts exhaust the cap with EMAXCONNSESSION). Defaults: park nothing, max 3.
DB_ADMIN_POOL_MIN=0
DB_ADMIN_POOL_MAX=3

# --- Cache (Redis 8.10.1) ---
# Laragon: localhost:6379 (install via Laragon Quick Add → Redis, then Start). Prod: rediss://:pass@host:6379/0
REDIS_URL=localhost:6379

# --- LLM Provider (DeepSeek OpenAI-compatible, master key — NEVER in client sites) ---
LLM_BASE_URL=https://api.deepseek.com   # Provider-swappable (e.g. mimo endpoint year 2)
LLM_API_KEY=sk-REPLACE_ME              # REQUIRED — DeepSeek API key (env secret, never logged)
LLM_MODEL=deepseek-chat                 # Default model for chat proxy

# --- Auth (Admin — for POST /v1/admin/clients, token creation) ---
ADMIN_API_KEY=REPLACE_ME_WITH_openssl_rand_hex_32   # REQUIRED — generate: openssl rand -hex 32

# --- Business Logic ---
MAX_TOKENS_PER_REQUEST=2048           # Max tokens forwarded to provider per /v1/chat call
RATE_LIMIT_PER_MINUTE=60              # Per client_token_hash + per IP (unauth) sliding window (Redis INCR+EXPIRE)
AGENT_RATE_LIMIT_PER_MINUTE=20        # Stricter per-IP sub-limit for /v1/agent/* (landing polls)

# --- Background loops: does this process persist between requests? ---
# Controls BOTH the 60s reminder ticker and the notify drain loop,
# because both answer the same question: is this a long-lived process
# that can own background work?
#
# true  = long-running hosts (Laragon, VPS, Railway). The process stays
#         alive between ticks, so the loops actually run.
# false = serverless (Vercel), where the function is destroyed between
#         requests. The loops would never tick, and Supabase owns
#         delivery instead: a pg_cron job calls the deliver-reminders
#         Edge Function, and a Database Webhook on notify_jobs INSERT
#         handles notifications instantly.
#         Leaving it true on serverless is not a correctness bug (the two
#         drivers claim rows and cannot double-send) but it spends
#         Active CPU on loops that can never fire.
#
# Only one should be active per environment. See ops/RUNBOOK-delivery.md.
BACKGROUND_TICKERS=true

# Trusted reverse-proxy CIDRs (comma-separated). When the app sits behind
# Render/Railway/nginx, list their egress CIDRs here so X-Forwarded-For /
# X-Real-IP are honored for rate-limit bucketing + client IP (see internal/api/clientip.go).
# Empty (default) = never trust forwarded headers.
# On Vercel this MUST be set to Vercel's egress ranges, or every client
# buckets as the same IP and you rate-limit yourself into 429s.
TRUSTED_PROXY_CIDRS=

# --- CORS ---
ALLOW_ORIGINS=*                       # Dev: * . Prod: https://client-a.my.id,https://client-b.my.id (csv, no spaces around commas is fine)

# --- Durable report storage (Supabase Storage) ---
# Prod: set both to use the private REPORT_BUCKET. The bucket must exist
# and stay private; downloads are app-proxied behind Redis tickets.
# Empty = local data/reports (dev/tests only, ephemeral on serverless).
SUPABASE_URL=                           # e.g. https://<ref>.supabase.co
SUPABASE_STORAGE_KEY=                   # server-only storage service key, never in clients
REPORT_BUCKET=reports
REPORT_MAX_BYTES=15000000

# --- Sentry (env-gated; leave empty to disable entirely) ---
SENTRY_DSN=                           # REQUIRED to enable. Get from sentry.io project settings.
SENTRY_ENV=development                # development | production
SENTRY_RELEASE=                       # default: build -ldflags (git rev)
TRACES_SAMPLE_RATE=0.1               # 0.0..1.0 (0 disables tracing)
